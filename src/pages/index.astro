---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar/Navbar.astro';
import HeroSection from '../components/Hero/HeroSection.astro';
import BlueRibbon from '../components/Marquee/BlueRibbon.astro';
import Sketchbook from '../components/Sketchbook/Sketchbook.astro';
import AboutSection from '../components/About/AboutSection.astro';
import SkillsSection from '../components/Skills/SkillsSection.astro';
import RedRibbon from '../components/Marquee/RedRibbon.astro';
import InspirationSection from '../components/Inspiration/InspirationSection.astro';
import Footer from '../components/Footer/Footer.astro';
import '../styles/global.css';

const title = 'Portfolio - Communication Design Student';
---

<MainLayout title={title}>
  <Navbar />
  <HeroSection />
  <Sketchbook />
  <BlueRibbon />
  <SkillsSection />
  <RedRibbon />
  <AboutSection />
  <InspirationSection />
  <Footer />
</MainLayout>  
<style>
  .nav{
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: var(--background-yellow);
  font-family: var(--font-titles);
  font-size: 50px;
  }
</style>
