---
interface Props {
  title?: string;
}

const { title = "Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Communication Design student portfolio - Photography, Illustration, Art Direction, Visual Storytelling" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;700&family=Londrina+Solid:wght@100;300;400;700;900&display=swap" rel="stylesheet">
    
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
  }
</style>
