---
interface Props {
  title?: string;
}

const { title = "Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Communication Design student portfolio - Photography, Illustration, Art Direction, Visual Storytelling" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;700&family=Londrina+Solid:wght@100;300;400;700;900&display=swap" rel="stylesheet">
    
    <title>{title}</title>
  </head>
  <body>
    <slot />
    
    <script>
      import gsap from "gsap";
      import ScrollTrigger from "gsap/ScrollTrigger";
      
      gsap.registerPlugin(ScrollTrigger);

      // We use Astro's page load event in case View Transitions are added later, 
      // but DOMContentLoaded works fine for standard Astro.
      function initParallax() {
        gsap.utils.toArray("[data-parallax]").forEach((el: any) => {
          const speed = parseFloat(el.dataset.parallax || "0.1");
          
          gsap.to(el, {
            y: () => -(window.innerHeight * speed),
            ease: "none",
            scrollTrigger: {
              trigger: el,
              start: "top bottom",
              end: "bottom top",
              scrub: true,
              invalidateOnRefresh: true
            },
          });
        });
      }

      document.addEventListener("DOMContentLoaded", initParallax);
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
  }
</style>
