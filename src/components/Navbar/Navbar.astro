---
// Navbar.astro
const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Work', href: '/work' },
  { label: 'Inspiration', href: '#inspiration' },
  { label: 'Contact', href: '#contact' }
];
---

<nav class="navbar">
  <div class="navbar-container">
    <div class="navbar-logo">
      <a href="/">Portfolio</a>
    </div>

    <input type="checkbox" id="nav-toggle" class="navbar-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="navbar-burger" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul class="navbar-menu">
      {navItems.map((item) => (
        <li class="navbar-item">
          <a href={item.href} class="navbar-link">{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .navbar {
    width: 100%;
    background-color: var(--yellow-base);
    border-bottom: var(--border-medium) solid var(--black);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .navbar-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-s) 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
  }

  .navbar-logo a {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--black);
  }

  .navbar-toggle {
    display: none;
  }

  .navbar-burger {
    display: none;
  }

  .navbar-burger span {
    display: block;
    width: 24px;
    height: 2px;
    margin: 5px 0;
    background-color: var(--black);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .navbar-menu {
    display: flex;
    gap: var(--spacing-lg);
    align-items: center;
    
  }

  .navbar-item {
    list-style: none;
  }

  .navbar-link {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--red-primary);
    transition: opacity var(--transition-fast);
  }

  .navbar-link:hover {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .navbar-container {
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
    }

    .navbar-burger {
      display: block;
      cursor: pointer;
      padding: var(--spacing-s);
    }

    .navbar-menu {
      width: 100%;
      flex-direction: column;
      gap: var(--spacing-md);
      overflow: hidden;
      max-height: 0;
      transition: max-height 0.25s ease;
    }

    .navbar-toggle:checked + .navbar-burger + .navbar-menu {
      max-height: 500px;
    }

    .navbar-link {
      width: 100%;
      padding: 0.75rem 0;
      text-align: center;
    }
  }
</style>
