---
// Footer.astro
const currentYear = new Date().getFullYear();
const socialLinks = [
  { label: 'Instagram', href: '#' },
  { label: 'Behance', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Email', href: 'mailto:hello@portfolio.com' }
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>Portfolio</h3>
        <p>A collection of creative work and visual explorations</p>
      </div>

      <div class="footer-section">
        <h3>Quick Links</h3>
        <ul class="footer-links">
          <li><a href="#about">About</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="#inspiration">Inspiration</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3>Follow</h3>
        <ul class="footer-links">
          {socialLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} All rights reserved. Made with creativity and passion.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background-color: var(--black);
    color: var(--white);
    padding: var(--spacing-2xl) 0 var(--spacing-lg) 0;
    margin-top: var(--spacing-2xl);
    border-top: var(--border-thick) solid var(--red-primary);
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
  }

  .footer-section h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--white);
    margin-bottom: var(--spacing-md);
  }

  .footer-section p {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--gray-light);
    line-height: var(--leading-relaxed);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--gray-light);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--yellow-base);
  }

  .footer-bottom {
    padding-top: var(--spacing-lg);
    border-top: var(--border-thin) solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .footer-bottom p {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--gray-light);
    margin: 0;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .footer {
      padding: var(--spacing-lg) 0;
    }

    .footer-content {
      gap: var(--spacing-lg);
    }

    .footer-section h3 {
      font-size: var(--text-base);
    }
  }
</style>
