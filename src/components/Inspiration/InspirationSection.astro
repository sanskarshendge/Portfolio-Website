---
// InspirationSection.astro
import inspiration from '../../data/inspiration.json';
---

<section class="inspiration" id="inspiration">
  <div class="inspiration-container">
    <div class="inspiration-header">
      <h2 class="inspiration-title">Daily Inspiration</h2>
      <p class="inspiration-subtitle">Collection of visual ideas and references</p>
    </div>

    <div class="inspiration-grid">
      {inspiration.map((item) => (
        <div class="inspiration-card">
          <div class="inspiration-image">
            <img src={item.image} alt={item.title} />
            <span class="inspiration-date">{item.date}</span>
          </div>
          <p class="inspiration-title-card">{item.title}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .inspiration {
    width: 100%;
    background-color: var(--yellow-base);
    padding: var(--spacing-2xl) 0;
  }

  .inspiration-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .inspiration-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .inspiration-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--black);
    margin-bottom: var(--spacing-sm);
  }

  .inspiration-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--gray-dark);
  }

  .inspiration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--spacing-lg);
  }

  .inspiration-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    cursor: pointer;
    transition: transform var(--transition-normal);
  }

  .inspiration-card:hover {
    transform: translateY(-4px);
  }

  .inspiration-image {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background-color: var(--gray-light);
    border-radius: var(--radius-lg);
    border: var(--border-medium) solid var(--black);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    color: var(--gray-medium);
    font-size: var(--text-sm);
  }

  .inspiration-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  .inspiration-date {
    position: absolute;
    bottom: var(--spacing-sm);
    left: var(--spacing-sm);
    background-color: rgba(0, 0, 0, 0.7);
    color: var(--white);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
  }

  .inspiration-title-card {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--black);
    line-height: var(--leading-normal);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .inspiration-title {
      font-size: var(--text-3xl);
    }

    .inspiration-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--spacing-md);
    }
  }
</style>
