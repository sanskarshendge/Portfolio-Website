---
// InspirationSection.astro
import DailyInspiration from "../Marquee/DailyInspiration.astro";
import InspirationFeed from "./InspirationFeed.astro";
---

<section class="inspiration" id="inspiration">
  <div class="Ribbon">
    <DailyInspiration />
  </div>
  <div class="inspiration-container">
    <InspirationFeed />
  </div>
</section>

<style>
  .inspiration {
    width: 100%;
    background-color: var(--white);
    padding: var(--spacing-md) 0 var(--spacing-2xl) 0;
  }

  .inspiration-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-xs);
    color: grey;
  }

  .inspiration-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .inspiration-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--black);
    margin-bottom: var(--spacing-sm);
  }

  .inspiration-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--gray-dark);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .inspiration-title {
      font-size: var(--text-3xl);
    }
  }
</style>
