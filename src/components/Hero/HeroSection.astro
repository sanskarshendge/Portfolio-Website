---
// HeroSection.astro
import Sketchbook from "../Sketchbook/Sketchbook.astro";
---

<section class="hero" id="hero">
  <div class="hero-video-wrapper" data-parallax="0.1">
    <video
      class="hero-video"
      src="/images/Animotion.mp4"
      autoplay
      loop
      muted
      playsinline></video>
    <h1 class="hero-title" data-parallax="-0.2"></h1>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: row;
    width: 100%;
    background-color: var(--yellow-base);
    position: relative;
  }
  .hero-video-wrapper {
    width: 100%;
    height: 420px; /* Adjust height if needed */
    position: relative;
    overflow: hidden;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ensures video fills the space beautifully */
    display: block;
  }
  .sketchbook {
    padding-top: var(--spacing-md);
    padding-bottom: var(--spacing-md);
  }
</style>
