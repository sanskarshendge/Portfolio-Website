---
// HeroSection.astro
import Sketchbook from '../Sketchbook/Sketchbook.astro';
---

<section class="hero" id="hero">
  <div class="placeholder" data-parallax="0.1">
    <h1 class="hero-title" data-parallax="-0.2"></h1>
    
  </div>
  
  
</section>

<style>
  .hero {
    diaplay: flex;
    flex-direction:row;
    width: 100%;
    background-color: var(--yellow-base);
    position: relative;
  }
  .placeholder{
    background-color: rgb(193, 193, 192);
    height: 420px;
    padding: var(--spacing-md);
  }
  .sketchbook {
    padding-top: var(--spacing-md);
    padding-bottom: var(--spacing-md);
  }

</style>
