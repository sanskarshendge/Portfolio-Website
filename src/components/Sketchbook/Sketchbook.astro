---
// Sketchbook.astro
---

<section class="sketchbook" id="sketchbook">
  <div class="sketchbook-container">
    <div class="sketchbook-content">
      <h2 class="sketchbook-title">Sketchbook</h2>
      <p class="sketchbook-description">Explore a visual collection of ideas, concepts, and creative explorations</p>
    </div>
    
    <div class="sketchbook-visual">
      <div class="sketchbook-card">
        <div class="sketchbook-inner">
          <div class="sketchbook-page left-page">
            <div class="page-content">Sketches & Ideas</div>
          </div>
          <div class="sketchbook-page right-page">
            <div class="page-content">Visual Concepts</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sketchbook {
    width: 100%;
    background-color: var(--yellow-base);
    padding: var(--spacing-2xl) 0;
  }

  .sketchbook-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-2xl);
    align-items: center;
  }

  .sketchbook-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .sketchbook-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--black);
  }

  .sketchbook-description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--gray-dark);
    line-height: var(--leading-relaxed);
  }

  .sketchbook-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .sketchbook-card {
    width: 100%;
    max-width: 450px;
    height: 350px;
    background-color: var(--black);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .sketchbook-inner {
    width: 100%;
    height: 100%;
    display: flex;
    gap: 2px;
    background-color: var(--black);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .sketchbook-page {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--paper);
    position: relative;
  }

  .left-page {
    border-radius: var(--radius-md) 0 0 var(--radius-md);
  }

  .right-page {
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    border-left: 1px dashed var(--gray-light);
  }

  .page-content {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--gray-dark);
    text-align: center;
    padding: var(--spacing-lg);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .sketchbook-container {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .sketchbook-card {
      height: 250px;
    }

    .sketchbook-title {
      font-size: var(--text-3xl);
    }

    .page-content {
      font-size: var(--text-base);
    }
  }
</style>
