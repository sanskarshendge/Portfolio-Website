---
// Sketchbook.astro
---


<section class="sketchbook-stage">
  <div class="sketchbook">

    <!-- Shadow -->
    <div class="book-shadow"></div>

    <!-- Pages -->
    <div class="book-pages">
      <div class="page page-3"></div>
      <div class="page page-2"></div>
      <div class="page page-1">
        <div class="page-content">
          <h3>Ideas</h3>
          <p>Hand-painted signs</p>
          <p>Truck typography</p>
          <p>Matchbox labels</p>
        </div>
      </div>
    </div>

    <!-- Cover -->
    <div class="book-cover">
      <div class="tape tape-1"></div>

      <div class="cover-content">
        <span class="label">SKETCHBOOK</span>

        <h1>Sanskar</h1>

        <p>Visual Notes • 2026</p>

        <div class="doodle"></div>
      </div>
    </div>

  </div>
</section>

<style>
  :root{
    --cover:#c62839;
    --cover-dark:#9f1d2d;
    --paper:#f8f3e6;
    --ink:#1f1f1f;
    --tape:#e7d4a3;
  }

  *{
    margin:0;
    padding:0;
    box-sizing:border-box;
  }

  .sketchbook-stage{
    min-height:660px;
    display:flex;
    justify-content:flex-start;
    align-items:center;

    padding-left:5vw;

    background: var(--yellow-base);
  }

  .sketchbook{
    position:relative;

    width:min(70vw,550px);
    aspect-ratio:1/1;

    transform:rotate(-8deg);
  }

  .book-shadow{
    position:absolute;
    inset:0;

    transform:
      translate(20px,20px);

    background:rgba(0,0,0,.15);

    filter:blur(20px);

    border-radius:12px;
  }

  .book-pages{
    position:absolute;
    inset:0;
  }

  .page{
    position:absolute;
    inset:0;

    background:var(--paper);

    border-radius:10px;

    border:1px solid rgba(0,0,0,.08);
  }

  .page-3{
    transform:
      translate(14px,14px);
  }

  .page-2{
    transform:
      translate(9px,9px);
  }

  .page-1{
    transform:
      translate(4px,4px);

    overflow:hidden;
  }

  .page-content{
    padding:40px;

    font-family:"Kalam", cursive;

    color:var(--ink);
  }

  .page-content h3{
    margin-bottom:16px;
    color:var(--cover);
  }

  .page-content p{
    margin-bottom:10px;
  }

  .book-cover{
    position:absolute;
    inset:0;

    background:
      linear-gradient(
        135deg,
        var(--cover),
        var(--cover-dark)
      );

    border-radius:12px;

    border:4px solid #8f1828;

    box-shadow:
      0 20px 40px rgba(0,0,0,.25);

    z-index:10;

    transform-origin:left center;

    overflow:hidden;
  }

  .cover-content{
    height:100%;

    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;

    text-align:center;

    color:white;

    padding:30px;
  }

  .label{
    font-size:.8rem;

    letter-spacing:3px;

    border:2px solid rgba(255,255,255,.5);

    padding:8px 14px;

    margin-bottom:20px;
  }

  .cover-content h1{
    font-size:3rem;

    margin-bottom:10px;
  }

  .cover-content p{
    opacity:.8;
  }

  .tape{
    position:absolute;

    width:120px;
    height:35px;

    background:var(--tape);

    opacity:.8;

    transform:
      rotate(-12deg);
  }

  .tape-1{
    top:20px;
    left:20px;
  }

  .doodle{
    width:100px;
    height:100px;

    margin-top:30px;

    border:3px solid rgba(255,255,255,.5);

    border-radius:50%;

    position:relative;
  }

  .doodle::before{
    content:"";

    position:absolute;

    width:60px;
    height:60px;

    border:3px solid rgba(255,255,255,.5);

    border-radius:50%;

    top:15px;
    left:15px;
  }
</style>

<script type="module">
// GSAP ScrollTrigger — Phase 1 only
// - Pins the `.sketchbook-stage` section when reached
// - Scrubs a timeline that moves the sketchbook to the viewport center
//   and straightens its rotation to 0deg
// - Structure includes clear placeholder comments for future phases
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

function setupSketchbookPhase1() {
  const section = document.querySelector('.sketchbook-stage');
  const sketchbook = section?.querySelector('.sketchbook');
  if (!section || !sketchbook) return;

  // Compute the X translation required to center the sketchbook in viewport.
  // Returning a function lets GSAP re-evaluate on refresh for responsive layouts.
  const getCenterXOffset = () => {
    const rect = sketchbook.getBoundingClientRect();
    const currentCenter = rect.left + rect.width / 2;
    const viewportCenter = window.innerWidth / 2;
    return viewportCenter - currentCenter;
  };

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: section,
      start: 'top top',
      // Keep the pin long enough for Phase 1; future phases can extend this
      end: () => '+=' + Math.max(window.innerHeight * 1.2, 800),
      pin: true,
      scrub: true,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      // markers: true, // uncomment for debugging phase boundaries
    }
  });

  // Phase 1: move to center (x) and straighten rotation. Only x & rotation
  // are animated here to satisfy the requirement. Use ease 'none' so the
  // scrub maps 1:1 with scroll progress.
  tl.to(sketchbook, {
    x: getCenterXOffset,
    rotation: 0,
    ease: 'none',
    duration: 1,
  });

  // Placeholder: Phase 2+ — add page open / page-turn animations here later.
  // Example (do not enable now):
  // tl.addLabel('phase2-start');
  // tl.to(coverEl, { rotationY: -120, duration: 1, ease: 'power1.inOut' });
  // tl.to(pageEl, { x: '+=100%', duration: 1 });

  // Responsive refresh handler
  const onResize = () => ScrollTrigger.refresh();
  window.addEventListener('resize', onResize);

  // Cleanup for SPA/HMR/unload
  function cleanup() {
    try {
      tl.kill();
      ScrollTrigger.getAll().forEach(st => st.kill());
    } catch (e) {}
    window.removeEventListener('resize', onResize);
  }

  // Expose cleanup if needed externally
  section._sketchbookPhase1Cleanup = cleanup;
}

if (typeof window !== 'undefined') {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSketchbookPhase1, { once: true });
  } else {
    setupSketchbookPhase1();
  }

  // Ensure cleanup on unload
  window.addEventListener('beforeunload', () => {
    const section = document.querySelector('.sketchbook-stage');
    if (section && section._sketchbookPhase1Cleanup) section._sketchbookPhase1Cleanup();
  });
}
</script>
