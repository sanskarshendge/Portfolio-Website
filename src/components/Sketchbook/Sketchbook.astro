---
// Sketchbook.astro
---

<section class="sketchbook-stage">
  <div class="sketchbook" data-parallax="0.05">
    <!-- Shadow -->
    <div class="book-shadow"></div>

    <!-- Pages -->
    <div class="book-pages">
      <div class="page page-6" data-page-index="6">
        <div class="page-inner">
          <div class="page-face page-front">
            <div class="page-paper"></div>
          </div>
          <div class="page-face page-back"></div>
        </div>
        <div class="page-edge"></div>
      </div>

      <div class="page page-5" data-page-index="5">
        <div class="page-inner">
          <div class="page-face page-front">
            <div class="page-paper"></div>
          </div>
          <div class="page-face page-back"></div>
        </div>
        <div class="page-edge"></div>
      </div>

      <div class="page page-4" data-page-index="4">
        <div class="page-inner">
          <div class="page-face page-front">
            <div class="page-paper"></div>
          </div>
          <div class="page-face page-back"></div>
        </div>
        <div class="page-edge"></div>
      </div>

      <div class="page page-3" data-page-index="3">
        <div class="page-inner">
          <div class="page-face page-front">
            <img
              src="/images/yellow.jpg"
              alt="Sketch 3"
              style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 10px; z-index: 10; transform: translateZ(1px);"
            />
          </div>
          <div class="page-face page-back"></div>
        </div>
        <div class="page-edge"></div>
      </div>

      <div class="page page-2" data-page-index="2" data-auto-flip="true">
        <div class="page-inner">
          <div class="page-face page-front">
            <img
              src="/images/surrfing-in-fire.jpg"
              alt="Sketch 2"
              style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 10px; z-index: 10; transform: translateZ(1px);"
            />
          </div>
          <div class="page-face page-back"></div>
        </div>
        <div class="page-edge"></div>
      </div>

      <div class="page page-1" data-page-index="1" data-auto-flip="true">
        <div class="page-inner">
          <div class="page-face page-front">
            <img
              src="/images/sketch1.jpg"
              alt="Sketch 1"
              style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 10px; z-index: 10; transform: translateZ(1px);"
            />
          </div>
          <div class="page-face page-back"></div>
        </div>
        <div class="page-edge"></div>
      </div>
    </div>

    <!-- Cover -->
    <div class="book-cover">
      <div class="book-cover-front">
        <div class="tape tape-1"></div>

        <div class="cover-content">
          <span class="label">SKETCHBOOK</span>

          <h1>Sanskar</h1>

          <p>Visual Notes • 2026</p>

          <div class="doodle"></div>
        </div>
      </div>
      <div class="book-cover-back"></div>
    </div>

    <div class="sketchbook-nav" aria-hidden="true">
      <button
        type="button"
        class="sketchbook-arrow sketchbook-arrow--prev"
        aria-label="Previous page">‹</button
      >
      <button
        type="button"
        class="sketchbook-arrow sketchbook-arrow--next"
        aria-label="Next page">›</button
      >
    </div>
  </div>
</section>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .sketchbook-stage {
    min-height: 600px;
    height: calc(100vh - var(--sketchbook-offset, 120px));
    display: flex;
    justify-content: flex-start;
    align-items: center;

    padding-top: 10px;
    padding-left: 5vw;
    padding-right: 5vw;
    padding-bottom: 40px;

    background: var(--yellow-base);
  }

  .sketchbook {
    position: relative;

    width: min(70vw, 550px);
    aspect-ratio: 1/1;

    transform: rotate(-8deg);
    /* enable 3D children and give a perspective for realistic rotateY */
    transform-style: preserve-3d;
    perspective: 1200px;
  }

  .book-shadow {
    position: absolute;
    inset: 0;

    transform: translate(20px, 20px);

    background: var(--sketchbook-shadow-dark);

    filter: blur(20px);

    border-radius: 12px;
  }

  .book-pages {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .page {
    position: absolute;
    inset: 0;

    transform-style: preserve-3d;
    backface-visibility: visible;
    -webkit-backface-visibility: visible;
    transform-origin: left center;
    will-change: transform;
  }

  .page-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .page-face {
    position: absolute;
    inset: 0;

    background: var(--sketchbook-paper);
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);

    transform-style: preserve-3d;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;

    overflow: hidden;
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    cursor: pointer;
  }

  .page-front {
    transform: rotateY(0deg);
    z-index: 2;
  }

  .page-back {
    transform: rotateY(180deg);
    z-index: 1;
    background: linear-gradient(
      180deg,
      var(--sketchbook-paper),
      var(--sketchbook-paper-dark)
    );
  }

  .page-back::before {
    content: "";
    position: absolute;
    inset: 24px 20px 24px;
    background-image: linear-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 1px);
    background-size: 100% 28px;
    opacity: 0.25;
  }

  .page-edge {
    position: absolute;
    top: 12px;
    right: -8px;
    width: 8px;
    height: calc(100% - 24px);
    background: linear-gradient(
      90deg,
      var(--sketchbook-shadow-light),
      var(--sketchbook-shadow-dark)
    );
    border-radius: 0 4px 4px 0;
    pointer-events: none;
  }

  .sketchbook-nav {
    position: absolute;
    bottom: -80px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 32px;
    pointer-events: none;
  }

  .sketchbook-arrow {
    width: 56px;
    height: 56px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: none;
    border-radius: 50%;
    background: var(--sketchbook-shadow-light);
    color: var(--sketchbook-ink);
    font-size: 2rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 12px 24px var(--sketchbook-shadow-dark);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      visibility 0.35s ease,
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .sketchbook-arrow:hover {
    background: #ffffff;
    transform: scale(1.08);
  }

  .sketchbook-nav.visible .sketchbook-arrow {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .sketchbook-arrow.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .page-6 {
    transform: translate(12px, 12px);
    z-index: 20;
  }

  .page-5 {
    transform: translate(9px, 9px);
    z-index: 30;
  }

  .page-4 {
    transform: translate(6px, 6px);
    z-index: 40;
  }

  .page-3 {
    transform: translate(3px, 3px);
    z-index: 50;
  }

  .page-2 {
    transform: translate(0px, 1px);
    z-index: 60;
  }

  .page-1 {
    transform: translate(0px, 0px);
    z-index: 70;
  }

  .page-content {
    padding: 40px;

    font-family: "Kalam", cursive;

    color: var(--sketchbook-ink);
  }

  .page-content h3 {
    margin-bottom: 16px;
    color: var(--sketchbook-cover);
  }

  .page-content p {
    margin-bottom: 10px;
  }

  .page-paper {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--sketchbook-paper) 0%,
      var(--sketchbook-paper-dark) 100%
    );
  }

  .book-cover {
    position: absolute;
    inset: 0;

    z-index: 100;

    /* cover opens around the left spine */
    transform-origin: left center;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .book-cover-front,
  .book-cover-back {
    position: absolute;
    inset: 0;

    border-radius: 12px;
    border: 4px solid var(--sketchbook-cover-accent);

    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
  }

  .book-cover-front {
    background: url("/images/backup sketchbook cover.jpg") center/cover
      no-repeat;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    transform: rotateY(0deg);
  }

  .book-cover-back {
    background: var(--sketchbook-cover);
    transform: rotateY(180deg);
    /* Inward shadow to give it some depth on the inside */
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.2);
  }

  .cover-content {
    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;

    color: white;

    padding: 30px;
  }

  .label {
    font-size: 0.8rem;

    letter-spacing: 3px;

    border: 2px solid var(--sketchbook-shadow-medium);

    padding: 8px 14px;

    margin-bottom: 20px;
  }

  .cover-content h1 {
    font-size: 3rem;

    margin-bottom: 10px;
  }

  .cover-content p {
    opacity: 0.8;
  }

  .tape {
    position: absolute;

    width: 120px;
    height: 35px;

    background: var(--sketchbook-tape);

    opacity: 0.8;

    transform: rotate(-12deg);
  }

  .tape-1 {
    top: 20px;
    left: 20px;
  }

  .doodle {
    width: 100px;
    height: 100px;

    margin-top: 30px;

    border: 3px solid var(--sketchbook-shadow-medium);

    border-radius: 50%;

    position: relative;
  }

  .doodle::before {
    content: "";

    position: absolute;

    width: 60px;
    height: 60px;

    border: 3px solid var(--sketchbook-shadow-medium);

    border-radius: 50%;

    top: 15px;
    left: 15px;
  }
</style>

<script type="module">
  // GSAP ScrollTrigger — Phase 1 only
  // - Pins the `.sketchbook-stage` section when reached
  // - Scrubs a timeline that moves the sketchbook to the viewport center
  //   and straightens its rotation to 0deg
  // - Structure includes clear placeholder comments for future phases
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function setupSketchbookPhase1() {
    const section = document.querySelector(".sketchbook-stage");
    const sketchbook = section?.querySelector(".sketchbook");
    if (!section || !sketchbook) return;

    // Compute the X translation required to center the sketchbook in viewport.
    // Returning a function lets GSAP re-evaluate on refresh for responsive layouts.
    const getCenterXOffset = () => {
      const rect = sketchbook.getBoundingClientRect();
      const currentCenter = rect.left + rect.width / 2;
      const viewportCenter = window.innerWidth / 2;
      return viewportCenter - currentCenter;
    };

    const header = document.querySelector(".navbar");
    const headerHeight = header?.offsetHeight || 88;
    const safeOffset = headerHeight + 16;

    section.style.setProperty("--sketchbook-offset", `${safeOffset}px`);

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: () => `top top+=${safeOffset}`,
        // Reserve roughly 4x viewport height for all 4 phases (center, cover, page1, page2)
        end: () => "+=" + Math.max(window.innerHeight * 4, 2400),
        pin: true,
        scrub: true,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        // markers: true, // uncomment for debugging phase boundaries
      },
    });

    // Phase 1: move to center (x) and straighten rotation. Only x & rotation
    // are animated here to satisfy the requirement. Use ease 'none' so the
    // scrub maps 1:1 with scroll progress.
    tl.to(sketchbook, {
      x: getCenterXOffset,
      rotation: 0,
      ease: "none",
      duration: 1,
    });

    // --- Phase 2: Open cover (rotateY around left spine) ------------------
    const cover = section.querySelector(".book-cover");
    if (cover) {
      // ensure starting state
      gsap.set(cover, { rotationY: 0 });
      // bring cover above pages while it opens
      tl.set(cover, { zIndex: 100 });
      tl.to(cover, {
        rotationY: -180,
        transformOrigin: "left center",
        ease: "none",
        duration: 1,
      });
    }

    // --- Phase 3: Flip first page (rotateY around left spine) -------------
    const page1 = section.querySelector(".page-1");
    if (page1) {
      gsap.set(page1, { rotationY: 0 });
      tl.set(page1, { zIndex: 101 });
      tl.to(page1, {
        rotationY: -165,
        transformOrigin: "left center",
        x: 0,
        duration: 1,
        ease: "none",
      });
    }

    // --- Phase 4: Flip second page --------------------------------------
    const page2 = section.querySelector(".page-2");
    if (page2) {
      gsap.set(page2, { rotationY: 0 });
      tl.set(page2, { zIndex: 102 });
      tl.to(page2, {
        rotationY: -170,
        transformOrigin: "left center",
        x: 1,
        duration: 1,
        ease: "none",
      });
    }

    const pages = Array.from(
      section.querySelectorAll(".page[data-page-index]"),
    ).sort((a, b) => Number(a.dataset.pageIndex) - Number(b.dataset.pageIndex));

    const navigation = section.querySelector(".sketchbook-nav");
    const prevArrow = navigation.querySelector(".sketchbook-arrow--prev");
    const nextArrow = navigation.querySelector(".sketchbook-arrow--next");

    const initialFlippedPageIndex = Math.max(
      0,
      ...pages
        .filter((page) => page.dataset.autoFlip === "true")
        .map((page) => Number(page.dataset.pageIndex)),
    );

    let currentPageIndex = initialFlippedPageIndex;
    const lastPageIndex =
      pages.length > 0 ? Number(pages[pages.length - 1].dataset.pageIndex) : 0;

    function updateNavigation() {
      if (!navigation) return;

      prevArrow.classList.toggle("hidden", currentPageIndex <= 0);
      nextArrow.classList.toggle("hidden", currentPageIndex >= lastPageIndex);
    }

    function showNavigation() {
      if (!navigation) return;
      // Allow showing navigation even if lastPageIndex <= initialFlippedPageIndex
      navigation.classList.add("visible");
      navigation.setAttribute("aria-hidden", "false");
      updateNavigation();
    }

    function hideNavigation() {
      if (!navigation) return;
      navigation.classList.remove("visible");
      navigation.setAttribute("aria-hidden", "true");
    }

    function nextPage() {
      if (currentPageIndex >= lastPageIndex) return;
      const nextPageIndex = currentPageIndex + 1;
      const nextPage = pages.find(
        (page) => Number(page.dataset.pageIndex) === nextPageIndex,
      );
      if (!nextPage) return;

      gsap.set(nextPage, { zIndex: 100 + nextPageIndex });
      gsap.to(nextPage, {
        rotationY: -180,
        x: -18 - (nextPageIndex - initialFlippedPageIndex - 1) * 6,
        transformOrigin: "left center",
        duration: 0.9,
        ease: "power1.out",
      });

      currentPageIndex = nextPageIndex;
      updateNavigation();
    }

    function previousPage() {
      if (currentPageIndex <= 0) return;
      const currentPage = pages.find(
        (page) => Number(page.dataset.pageIndex) === currentPageIndex,
      );
      if (!currentPage) return;

      gsap.to(currentPage, {
        rotationY: 0,
        x: 0,
        transformOrigin: "left center",
        duration: 0.9,
        ease: "power1.out",
        onComplete: () => {
          gsap.set(currentPage, { clearProps: "zIndex" });
        },
      });

      currentPageIndex -= 1;
      updateNavigation();
    }

    nextArrow.addEventListener("click", (event) => {
      event.stopPropagation();
      nextPage();
    });

    prevArrow.addEventListener("click", (event) => {
      event.stopPropagation();
      previousPage();
    });

    pages.forEach((page) => {
      // Don't add manual click listeners to pages controlled by the scroll timeline
      if (page.dataset.autoFlip === "true") return;

      const front = page.querySelector(".page-front");
      const back = page.querySelector(".page-back");

      if (front) {
        front.addEventListener("click", () => {
          nextPage();
        });
      }

      if (back) {
        back.addEventListener("click", () => {
          previousPage();
        });
      }
    });

    tl.eventCallback("onComplete", showNavigation);
    tl.eventCallback("onReverseComplete", hideNavigation);

    // When the timeline completes (scroll reaches `end`) the pin will be
    // released automatically and normal scrolling resumes.

    // Responsive refresh handler
    const onResize = () => ScrollTrigger.refresh();
    window.addEventListener("resize", onResize);

    // Cleanup for SPA/HMR/unload
    function cleanup() {
      try {
        tl.kill();
        ScrollTrigger.getAll().forEach((st) => st.kill());
      } catch (e) {}
      window.removeEventListener("resize", onResize);
    }

    // Expose cleanup if needed externally
    section._sketchbookPhase1Cleanup = cleanup;
  }

  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupSketchbookPhase1, {
        once: true,
      });
    } else {
      setupSketchbookPhase1();
    }

    // Ensure cleanup on unload
    window.addEventListener("beforeunload", () => {
      const section = document.querySelector(".sketchbook-stage");
      if (section && section._sketchbookPhase1Cleanup)
        section._sketchbookPhase1Cleanup();
    });
  }
</script>
