---

<section class="blue-ribbon">
  <div class="ribbon-track">
    <div class="ribbon-container">
      <div class="ribbon-content">
        <span class="ribbon-text">Photography</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Illustration</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Art Direction</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Visual Storytelling</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Branding</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Ui/Ux</span>
        
      </div>
    </div> 
    <!--Duplicate --> 
    <div class="ribbon-container">
      <div class="ribbon-content">
        <span class="ribbon-text">Photography</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Illustration</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Art Direction</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Visual Storytelling</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Branding</span>
        <span class="ribbon-separator">•</span>
        <span class="ribbon-text">Ui/Ux</span>
      </div>
   </div>
  </div> 
</section>

<style>
  .blue-ribbon {
    width: 100%;
    background-color: var(--blue-primary);
    padding: var(--spacing-lg) 0;
    margin: var(--spacing-xl) 0;

    overflow: hidden;
    transform: skewY(-2deg);
    
    
  }

  .ribbon-container {
    max-width: 100%;
    padding: 0 var(--spacing-md);
    
  }

  .ribbon-content {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--spacing-md);
    width:auto;
   
    
    
   
  }

  .ribbon-text {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--white);
    flex-wrap: nowrap;
  

    
  }

  .ribbon-separator {
    font-size: var(--text-2xl);
    color: var(--white);
    opacity: 0.6;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .ribbon-text {
      font-size: var(--text-lg);
    }

    .ribbon-separator {
      font-size: var(--text-lg);
    }

    .blue-ribbon {
      padding: var(--spacing-md) 0;
      margin: var(--spacing-lg) 0;
    }
  }
  .ribon-track{}
</style>
