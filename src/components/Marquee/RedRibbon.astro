---
// RedRibbon.astro
---

<section class="red-ribbon">
  <div class="ribbon-container">
    <div class="ribbon-content">
      <span class="ribbon-label">Cinematography</span>
      <span class="ribbon-dot">•</span>
      <span class="ribbon-label">Visual Storyteller</span>
      <span class="ribbon-dot">•</span>
      <span class="ribbon-label">Creative Director</span>
    </div>
  </div>
</section>

<style>
  .red-ribbon {
    width: 100%;
    background-color: var(--red-primary);
    padding: var(--spacing-lg) 0;
    margin: var(--spacing-xl) 0;
    overflow: hidden;
    transform: skewY(-2deg);
  }

  .ribbon-container {
    max-width: 100%;
    padding: 0 var(--spacing-md);
  }

  .ribbon-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    transform: skewY(2deg);
  }

  .ribbon-label {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--white);
  }

  .ribbon-dot {
    font-size: var(--text-2xl);
    color: var(--white);
    opacity: 0.6;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .ribbon-label {
      font-size: var(--text-lg);
    }

    .ribbon-dot {
      font-size: var(--text-lg);
    }

    .red-ribbon {
      padding: var(--spacing-md) 0;
      margin: var(--spacing-lg) 0;
    }
  }
</style>
