<style>
  .red-ribbon {
    position:relative;
    width: 100%;
    background-color: var(--red-primary);
   /* padding: var(--spacing-lg) 0;*/
    margin: var(--spacing-xl) 0;
    overflow: hidden;
    transform: skewY(2deg);
  }

  .ribbon-track {
    display: flex;
    width: max-content;
    align-items: center;
    will-change: transform;
    animation: marquee-right 30s linear infinite;
  }

  .ribbon-container {
    flex: 0 0 auto;
    padding: 0 var(--spacing-md);
  }

  .ribbon-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ribbon-label {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--white);
    white-space: nowrap;
    flex-shrink: 0;
    padding: var(--spacing-xs);
  }

  .ribbon-dot {
    font-size: var(--text-2xl);
    color: var(--white);
    opacity: 0.6;
    flex-shrink: 0;
  }

  .red-ribbon:hover .ribbon-track {
    animation-play-state: paused;
  }
  .runner{
  position:relative;

  left:15%;
  top:0;

  transform:
    translateY(-70%)
    skewY(-2deg);

  z-index:100;

  pointer-events:none;
}



  @keyframes marquee-right {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .ribbon-label {
      font-size: var(--text-lg);
    }

    .ribbon-dot {
      font-size: var(--text-lg);
    }

    .red-ribbon {
      padding: var(--spacing-xs) 0;
      margin: var(--spacing-lg) 0;
    }
  }
</style>
