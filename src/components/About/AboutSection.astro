---
// AboutSection.astro
import about from "../../data/about.json";
---

<section class="about" id="about">
  <div class="about-container">
    <div class="about-content">
      <h2 class="about-title">{about.title}</h2>
      <p class="about-intro">{about.intro}</p>
      <p class="about-bio">{about.bio}</p>
    </div>
  </div>
  <img
    src="/images/illustration.png"
    alt="Illustration"
    class="about-illustration"
    data-parallax="-0.1"
  />
</section>

<style>
  .about {
    position: relative;
    width: 100%;
    background-color: var(--yellow-base);
    padding: var(--spacing-2xl) 0;
    overflow: hidden;
  }

  .about-illustration {
    mix-blend-mode: multiply;
    position: absolute;
    bottom: 5%;
    right: 5%;
    width: 65%;
    max-height: 100%;
    object-fit: contain;
    object-position: bottom right;
    z-index: 0;
    pointer-events: none;
  }

  .about-container {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--spacing-2xl);
    display: flex;
  }

  .about-content {
    width: 35%;
    max-width: 450px;
    padding-top: var(--spacing-xl);
  }

  .about-title {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 900;
    color: var(--black);
    margin-bottom: var(--spacing-xl);
  }

  .about-intro {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--black);
    line-height: 1.4;
    margin-bottom: var(--spacing-sm);
  }

  .about-bio {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--black);
    line-height: 1.4;
  }

  .contact-email,
  .contact-location {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--gray-dark);
    margin: 0;
  }

  .contact-email a,
  .contact-location a {
    color: var(--blue-primary);
    text-decoration: underline;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .about-illustration {
      position: relative;
      width: 90%;
      bottom: auto;
      right: auto;
      margin: 0 auto;
      display: block;
    }

    .about-container {
      padding: 0 var(--spacing-md);
    }

    .about-content {
      width: 100%;
      max-width: none;
      padding-top: 0;
    }

    .about-title {
      font-size: 3rem;
    }

    .about-intro,
    .about-bio {
      font-size: 1rem;
    }
  }
</style>
