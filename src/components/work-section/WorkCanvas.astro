---
import "../../styles/global.css";

// src/components/WorkCanvas.astro
// Draggable "wall of cards" work section.
// Pan with mouse-drag, touch-drag, or scroll wheel. Inertia on release,
// soft bounce-back at edges. No external animation library.

export interface Project {
  title: string;
  category: string;
  tools: string;
  year: string;
  image: string;
  href: string;
  size?: "sm" | "md" | "lg"; // controls card footprint in the grid
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props as Props;
---

<section class="work" aria-label="Work">
  <div class="viewport" id="work-viewport">
    <div class="track" id="work-track">
      {
        Array.from({ length: 3 }).map((_, blockIndex) => (
          <div class="project-block" data-block={blockIndex}>
            {projects.map((project, i) => (
              <a
                class={`card card--${project.size ?? "md"}`}
                href={project.href}
                style={`--jitter: ${((i % 5) - 2) * 0.6}deg`}
              >
                <div class="card__image-wrap">
                  <img
                    class="card__image"
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                    draggable="false"
                  />
                </div>
                <div class="card__meta">
                  <span class="card__title">{project.title} </span> <br />
                  <span class="card__sub">
                    {project.category}
                    <br />
                  </span>
                  <span class="card__sub card__sub--faint">
                    {project.tools} — {project.year}
                  </span>
                </div>
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <p class="hint" id="work-hint" aria-hidden="true">scroll / drag to move</p>
</section>

<style>
  .work {
    min-height: 100vh;
    overflow: visible;
  }
  .card__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(255, 255, 255, 0.212) 3px,
      transparent 0
    );
    background-size: 28px 28px;
  }

  .viewport.is-dragging {
    cursor: grabbing;
  }

  .track {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0 auto;
  }

  .project-block {
    column-count: 3;
    column-gap: 40px;
    width: 100%;
    max-width: 1400px;
    padding: 120px 40px;
    margin: 0 auto;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--work-text);
    transform: rotate(var(--jitter));
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    user-select: none;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 60px;
  }

  /* No longer need grid-column spanning for lg/md/sm since columns wrap content naturally */

  .card:hover {
    transform: rotate(0deg) scale(1.045) translateY(-4px);
    z-index: 2;
  }
  .card--lg .card__image-wrap {
  }

  .card__image-wrap {
    position: relative;
    aspect-ratio: auto;
    overflow: hidden;
    background: var(--work-bg);
    box-shadow: 0 18px 30px -14px rgba(0, 0, 0, 0.7);
    transition: box-shadow 0.25s ease;
  }

  .card:hover .card__image-wrap {
    box-shadow: 0 28px 48px -16px rgba(0, 0, 0, 0.85);
  }

  .card__title {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .card__sub {
    font-family: var(--font-body);
    font-size: var(--text-base);
    letter-spacing: 0.02em;
    color: var(--work-text-muted);
    text-transform: uppercase;
  }

  .card__sub--faint {
    color: var(--work-text-faint);
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    margin: 0;
    padding: 8px 16px;
    border: 1px solid var(--work-border);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--work-text);
    background: var(--work-overlay);
    backdrop-filter: blur(6px);
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.6s ease;
    z-index: 3;
  }

  .hint.is-hidden {
    opacity: 0;
  }

  @media (max-width: 720px) {
    .project-block {
      column-count: 1;
      column-gap: 20px;
      padding: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__image-wrap,
    .hint {
      transition: none;
    }
  }
</style>

<script>
  // Vanilla drag + momentum + infinite loop for the work canvas.
  // Runs once per WorkCanvas instance on the page.

  function initWorkCanvas() {
    const viewport = document.getElementById(
      "work-viewport",
    ) as HTMLElement | null;
    const track = document.getElementById("work-track") as HTMLElement | null;
    const hint = document.getElementById("work-hint") as HTMLElement | null;
    if (!viewport || !track) return;

    const V = viewport as HTMLElement;
    const T = track as HTMLElement;
    const H = hint as HTMLElement | null;

    let x = 0;
    let y = 0;

    // Calculate block size based on track size / 3
    let blockH = 0;

    function measureBlocks() {
      // The track is a vertical stack of 3 blocks.
      blockH = T.scrollHeight / 3;
    }

    // Parallax offsets from mouse movement
    let parallaxX = 0;
    let parallaxY = 0;
    let targetParallaxX = 0;
    let targetParallaxY = 0;
    let parallaxFrame: number | null = null;

    // Edge auto-pan
    let pointerX = 0;
    let pointerY = 0;
    let autoPanVX = 0;
    let autoPanVY = 0;
    let autoPanFrame: number | null = null;

    let startX = 0;
    let startY = 0;
    let originX = 0;
    let originY = 0;
    let velocityX = 0;
    let velocityY = 0;
    let lastMoveX = 0;
    let lastMoveY = 0;
    let lastMoveTime = 0;
    let isDragging = false;
    let momentumFrame: number | null = null;
    let hasInteracted = false;

    const FRICTION = 0.94;
    const PARALLAX_MAX = 28;
    const PARALLAX_SMOOTH = 0.14;
    const EDGE_ZONE = 96;
    const EDGE_PAN_MAX = 12;

    function wrapCoordinates() {
      measureBlocks();
      if (blockH === 0) return;

      // Lock X axis completely
      x = 0;
      originX = 0;
      velocityX = 0;

      if (y > -blockH / 2) {
        y -= blockH;
        originY -= blockH;
      } else if (y < -blockH * 1.5) {
        y += blockH;
        originY += blockH;
      }
    }

    function setTransform(px: number, py: number) {
      T.style.transform = `translate3d(${px + parallaxX}px, ${py + parallaxY}px, 0)`;
    }

    function dismissHint() {
      if (hasInteracted || !H) return;
      hasInteracted = true;
      H.classList.add("is-hidden");
    }

    function stopMomentum() {
      if (momentumFrame !== null) {
        cancelAnimationFrame(momentumFrame);
        momentumFrame = null;
      }
    }

    function animateParallax() {
      parallaxX += (targetParallaxX - parallaxX) * PARALLAX_SMOOTH;
      parallaxY += (targetParallaxY - parallaxY) * PARALLAX_SMOOTH;
      setTransform(x, y);
      if (
        Math.abs(targetParallaxX - parallaxX) > 0.05 ||
        Math.abs(targetParallaxY - parallaxY) > 0.05
      ) {
        parallaxFrame = requestAnimationFrame(animateParallax);
      } else {
        parallaxFrame = null;
      }
    }

    function animateAutoPan() {
      x = x + autoPanVX;
      y = y + autoPanVY;
      wrapCoordinates();
      setTransform(x, y);

      if (Math.abs(autoPanVX) > 0.01 || Math.abs(autoPanVY) > 0.01) {
        autoPanFrame = requestAnimationFrame(animateAutoPan);
      } else {
        autoPanFrame = null;
      }
    }

    function runMomentum() {
      velocityX *= FRICTION;
      velocityY *= FRICTION;
      x += velocityX;
      y += velocityY;

      wrapCoordinates();
      setTransform(x, y);

      if (Math.abs(velocityX) > 0.3 || Math.abs(velocityY) > 0.3) {
        momentumFrame = requestAnimationFrame(runMomentum);
      } else {
        momentumFrame = null;
      }
    }

    function onPointerDown(e: PointerEvent) {
      dismissHint();
      stopMomentum();
      T.style.transition = "none";
      isDragging = true;
      V.classList.add("is-dragging");
      startX = e.clientX;
      startY = e.clientY;
      originX = x;
      originY = y;
      lastMoveX = e.clientX;
      lastMoveY = e.clientY;
      lastMoveTime = performance.now();
      velocityX = 0;
      velocityY = 0;
      V.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) {
        if (e.pointerType === "mouse") {
          const rect = V.getBoundingClientRect();
          const nx =
            (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
          const ny =
            (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
          targetParallaxX = -nx * PARALLAX_MAX;
          targetParallaxY = -ny * (PARALLAX_MAX * 0.6);

          pointerX = e.clientX - rect.left;
          pointerY = e.clientY - rect.top;

          const zone = EDGE_ZONE;
          autoPanVX = 0;
          autoPanVY = 0;
          if (pointerX < zone) {
            autoPanVX = ((zone - pointerX) / zone) * EDGE_PAN_MAX;
          } else if (pointerX > rect.width - zone) {
            autoPanVX =
              -((pointerX - (rect.width - zone)) / zone) * EDGE_PAN_MAX;
          }
          if (pointerY < zone) {
            autoPanVY = ((zone - pointerY) / zone) * (EDGE_PAN_MAX * 0.45);
          } else if (pointerY > rect.height - zone) {
            autoPanVY =
              -((pointerY - (rect.height - zone)) / zone) *
              (EDGE_PAN_MAX * 0.45);
          }

          if (parallaxFrame === null)
            parallaxFrame = requestAnimationFrame(animateParallax);
          if (
            (Math.abs(autoPanVX) > 0.01 || Math.abs(autoPanVY) > 0.01) &&
            autoPanFrame === null
          ) {
            autoPanFrame = requestAnimationFrame(animateAutoPan);
          }
        }
        return;
      }

      let nextX = 0;
      let nextY = originY + (e.clientY - startY);

      x = nextX;
      y = nextY;
      wrapCoordinates();
      setTransform(x, y);

      const now = performance.now();
      const dt = Math.max(now - lastMoveTime, 1);
      velocityX = 0;
      velocityY = ((e.clientY - lastMoveY) / dt) * 16;
      lastMoveX = e.clientX;
      lastMoveY = e.clientY;
      lastMoveTime = now;
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      V.classList.remove("is-dragging");
      V.releasePointerCapture(e.pointerId);
      momentumFrame = requestAnimationFrame(runMomentum);

      targetParallaxX = 0;
      targetParallaxY = 0;
      if (parallaxFrame === null)
        parallaxFrame = requestAnimationFrame(animateParallax);
    }

    function onWheel(e: WheelEvent) {
      e.preventDefault();
      dismissHint();
      stopMomentum();
      T.style.transition = "none";

      x = 0;
      y -= e.deltaY;
      wrapCoordinates();
      setTransform(x, y);

      velocityX = 0;
      velocityY = -e.deltaY * 0.5;
      momentumFrame = requestAnimationFrame(runMomentum);

      targetParallaxX = 0;
      targetParallaxY = -e.deltaY * 0.015;
      if (parallaxFrame === null)
        parallaxFrame = requestAnimationFrame(animateParallax);
    }

    V.addEventListener("pointerdown", onPointerDown);
    V.addEventListener("pointermove", onPointerMove);
    V.addEventListener("pointerup", onPointerUp);
    V.addEventListener("pointercancel", onPointerUp);
    V.addEventListener("wheel", onWheel, { passive: false });
    V.addEventListener("pointerleave", () => {
      targetParallaxX = 0;
      targetParallaxY = 0;
      if (parallaxFrame === null)
        parallaxFrame = requestAnimationFrame(animateParallax);
    });

    V.addEventListener("dragstart", (e) => e.preventDefault());

    // Initialize to the center block
    setTimeout(() => {
      measureBlocks();
      x = 0;
      y = -blockH;
      setTransform(x, y);
    }, 50);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWorkCanvas);
  } else {
    initWorkCanvas();
  }
</script>
