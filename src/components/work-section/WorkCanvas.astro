---
import "../../styles/global.css";

// src/components/WorkCanvas.astro
// Draggable "wall of cards" work section.
// Pan with mouse-drag, touch-drag, or scroll wheel. Inertia on release,
// soft bounce-back at edges. No external animation library.

export interface Project {
  title: string;
  category: string;
  tools: string;
  year: string;
  image: string;
  href: string;
  size?: "sm" | "md" | "lg"; // controls card footprint in the grid
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props as Props;
---

<section class="work" aria-label="Work">
  <div class="viewport" id="work-viewport">
    <div class="track" id="work-track">
      <div class="project-block">
        {projects.map((project, i) => (
          <a
            class={`card card--${project.size ?? "md"}`}
            href={project.href}
            style={`--jitter: ${((i % 5) - 2) * 0.6}deg`}
          >
            <div class="card__image-wrap">
              <img
                src={project.image}
                alt={project.title}
                class="card__image"
                loading="lazy"
              />
            </div>
            <div class="card__meta">
              <span class="card__title">{project.title} </span> <br>
              <span class="card__sub">
                {project.category}
                <br />
              </span>
              <span class="card__sub card__sub--faint">
                {project.tools} — {project.year}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>


</section>

<style>
  .work {
    min-height: 100vh;
    overflow: visible;
  }
  .card__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .viewport {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(255, 255, 255, 0.212) 3px,
      transparent 0
    );
    background-size: 28px 28px;
  }

  .track {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0 auto;
  }

  .project-block {
    column-count: 3;
    column-gap: 40px;
    width: 100%;
    max-width: 1400px;
    padding: 120px 40px;
    margin: 0 auto;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--work-text);
    transform: rotate(var(--jitter));
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    user-select: none;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 60px;
  }

  /* No longer need grid-column spanning for lg/md/sm since columns wrap content naturally */

  .card:hover {
    transform: rotate(0deg) scale(1.045) translateY(-4px);
    z-index: 2;
  }
  .card--lg .card__image-wrap {
  }

  .card__image-wrap {
    position: relative;
    aspect-ratio: auto;
    overflow: hidden;
    background: var(--work-bg);
    box-shadow: 0 18px 30px -14px rgba(0, 0, 0, 0.7);
    transition: box-shadow 0.25s ease;
  }

  .card:hover .card__image-wrap {
    box-shadow: 0 28px 48px -16px rgba(0, 0, 0, 0.85);
  }

  .card__title {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .card__sub {
    font-family: var(--font-body);
    font-size: var(--text-base);
    letter-spacing: 0.02em;
    color: var(--work-text-muted);
    text-transform: uppercase;
  }

  .card__sub--faint {
    color: var(--work-text-faint);
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    margin: 0;
    padding: 8px 16px;
    border: 1px solid var(--work-border);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--work-text);
    background: var(--work-overlay);
    backdrop-filter: blur(6px);
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.6s ease;
    z-index: 3;
  }

  .hint.is-hidden {
    opacity: 0;
  }

  @media (max-width: 720px) {
    .project-block {
      column-count: 2;
      column-gap: 20px;
      padding: 40px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__image-wrap,
    .hint {
      transition: none;
    }
  }
</style>

