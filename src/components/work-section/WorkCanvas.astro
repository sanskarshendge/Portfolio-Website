<script>
  // Vanilla drag + momentum + edge bounce-back for the work canvas.
  // Runs once per WorkCanvas instance on the page.

  function initWorkCanvas() {
    const viewport = document.getElementById("work-viewport") as HTMLElement | null;
    const track = document.getElementById("work-track") as HTMLElement | null;
    const hint = document.getElementById("work-hint") as HTMLElement | null;
    if (!viewport || !track) return;
    // Narrow to non-null typed aliases so inner functions don't see these as possibly null
    const V = viewport as HTMLElement;
    const T = track as HTMLElement;
    const H = hint as HTMLElement | null;

    let x = 0;
    let y = 0;
    // Parallax offsets from mouse movement
    let parallaxX = 0;
    let parallaxY = 0;
    let targetParallaxX = 0;
    let targetParallaxY = 0;
    let parallaxFrame: number | null = null;
    // Edge auto-pan: pointer tracking and auto-pan velocities
    let pointerX = 0;
    let pointerY = 0;
    let autoPanVX = 0;
    let autoPanVY = 0;
    let autoPanFrame: number | null = null;
    let startX = 0;
    let startY = 0;
    let originX = 0;
    let originY = 0;
    let velocityX = 0;
    let velocityY = 0;
    let lastMoveX = 0;
    let lastMoveY = 0;
    let lastMoveTime = 0;
    let isDragging = false;
    let momentumFrame: number | null = null;
    let hasInteracted = false;

    const FRICTION = 0.94; // per-frame velocity decay during momentum
    const BOUNCE_DURATION = 400; // ms, edge snap-back transition
    const PARALLAX_MAX = 28; // px max offset for parallax
    const PARALLAX_SMOOTH = 0.14; // lerp factor
    const EDGE_ZONE = 96; // px from edge to begin auto-pan
    const EDGE_PAN_MAX = 12; // max px per frame auto-pan speed

    function getBounds() {
      const trackRect = T.getBoundingClientRect();
      const viewportRect = V.getBoundingClientRect();
      // Track is rendered at transform:none scale, so measure natural size.
      const trackWidth = T.scrollWidth;
      const trackHeight = T.scrollHeight;
      const minX = Math.min(0, viewportRect.width - trackWidth);
      const minY = Math.min(0, viewportRect.height - trackHeight);
      return { minX, maxX: 0, minY, maxY: 0 };
    }

    function setTransform(px: number, py: number) {
      T.style.transform = `translate3d(${px + parallaxX}px, ${py + parallaxY}px, 0)`;
    }

    function clamp(value: number, min: number, max: number) {
      return Math.max(min, Math.min(max, value));
    }

    function dismissHint() {
      if (hasInteracted || !H) return;
      hasInteracted = true;
      H.classList.add("is-hidden");
    }

    function stopMomentum() {
      if (momentumFrame !== null) {
        cancelAnimationFrame(momentumFrame);
        momentumFrame = null;
      }
    }

    function animateParallax() {
      parallaxX += (targetParallaxX - parallaxX) * PARALLAX_SMOOTH;
      parallaxY += (targetParallaxY - parallaxY) * PARALLAX_SMOOTH;
      setTransform(x, y);
      if (Math.abs(targetParallaxX - parallaxX) > 0.05 || Math.abs(targetParallaxY - parallaxY) > 0.05) {
        parallaxFrame = requestAnimationFrame(animateParallax);
      } else {
        parallaxFrame = null;
      }
    }

    function animateAutoPan() {
      // Apply auto-pan velocity while active
      x = x + autoPanVX;
      y = y + autoPanVY;
      const { minX, maxX, minY, maxY } = getBounds();
      // Clamp softly to bounds while auto-panning
      x = clamp(x, minX - 60, maxX + 60);
      y = clamp(y, minY - 60, maxY + 60);
      setTransform(x, y);
      // keep running while velocity present
      if (Math.abs(autoPanVX) > 0.01 || Math.abs(autoPanVY) > 0.01) {
        autoPanFrame = requestAnimationFrame(animateAutoPan);
      } else {
        autoPanFrame = null;
      }
    }

    function settleToBounds() {
      const { minX, maxX, minY, maxY } = getBounds();
      const targetX = clamp(x, minX, maxX);
      const targetY = clamp(y, minY, maxY);
      if (targetX !== x || targetY !== y) {
        T.style.transition = `transform ${BOUNCE_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        x = targetX;
        y = targetY;
        setTransform(x, y);
        window.setTimeout(() => {
          T.style.transition = "none";
        }, BOUNCE_DURATION);
      }
    }

    function runMomentum() {
      const { minX, maxX, minY, maxY } = getBounds();

      // Extra pull back toward bounds if we're outside them (rubber-band feel).
      if (x > maxX) velocityX -= (x - maxX) * 0.12;
      if (x < minX) velocityX -= (x - minX) * 0.12;
      if (y > maxY) velocityY -= (y - maxY) * 0.12;
      if (y < minY) velocityY -= (y - minY) * 0.12;

      velocityX *= FRICTION;
      velocityY *= FRICTION;
      x += velocityX;
      y += velocityY;
      setTransform(x, y);

      if (Math.abs(velocityX) > 0.3 || Math.abs(velocityY) > 0.3) {
        momentumFrame = requestAnimationFrame(runMomentum);
      } else {
        momentumFrame = null;
        settleToBounds();
      }
    }

    function onPointerDown(e: PointerEvent) {
      dismissHint();
      stopMomentum();
      T.style.transition = "none";
      isDragging = true;
      V.classList.add("is-dragging");
      startX = e.clientX;
      startY = e.clientY;
      originX = x;
      originY = y;
      lastMoveX = e.clientX;
      lastMoveY = e.clientY;
      lastMoveTime = performance.now();
      velocityX = 0;
      velocityY = 0;
      V.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e: PointerEvent) {
      // If not dragging, use mouse movement to drive parallax (desktop only)
      if (!isDragging) {
        if (e.pointerType === "mouse") {
          const rect = V.getBoundingClientRect();
          const nx = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
          const ny = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
          targetParallaxX = clamp(-nx * PARALLAX_MAX, -PARALLAX_MAX, PARALLAX_MAX);
          targetParallaxY = clamp(-ny * (PARALLAX_MAX * 0.6), -PARALLAX_MAX, PARALLAX_MAX);
          // pointer position for auto-pan
          pointerX = e.clientX - rect.left;
          pointerY = e.clientY - rect.top;
          // compute auto-pan velocities based on proximity to edges
          const zone = EDGE_ZONE;
          autoPanVX = 0;
          autoPanVY = 0;
          if (pointerX < zone) {
            autoPanVX = ((zone - pointerX) / zone) * EDGE_PAN_MAX;
          } else if (pointerX > rect.width - zone) {
            autoPanVX = -((pointerX - (rect.width - zone)) / zone) * EDGE_PAN_MAX;
          }
          if (pointerY < zone) {
            autoPanVY = ((zone - pointerY) / zone) * (EDGE_PAN_MAX * 0.45);
          } else if (pointerY > rect.height - zone) {
            autoPanVY = -((pointerY - (rect.height - zone)) / zone) * (EDGE_PAN_MAX * 0.45);
          }
          if (parallaxFrame === null) parallaxFrame = requestAnimationFrame(animateParallax);
          if ((Math.abs(autoPanVX) > 0.01 || Math.abs(autoPanVY) > 0.01) && autoPanFrame === null) {
            autoPanFrame = requestAnimationFrame(animateAutoPan);
          }
        }
        return;
      }

      const { minX, maxX, minY, maxY } = getBounds();

      let nextX = originX + (e.clientX - startX);
      let nextY = originY + (e.clientY - startY);

      // Soft resistance past the edges.
      if (nextX > maxX) nextX = maxX + (nextX - maxX) * 0.35;
      if (nextX < minX) nextX = minX + (nextX - minX) * 0.35;
      if (nextY > maxY) nextY = maxY + (nextY - maxY) * 0.35;
      if (nextY < minY) nextY = minY + (nextY - minY) * 0.35;

      x = nextX;
      y = nextY;
      setTransform(x, y);

      const now = performance.now();
      const dt = Math.max(now - lastMoveTime, 1);
      velocityX = ((e.clientX - lastMoveX) / dt) * 16; // scale to ~per-frame px
      velocityY = ((e.clientY - lastMoveY) / dt) * 16;
      lastMoveX = e.clientX;
      lastMoveY = e.clientY;
      lastMoveTime = now;
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      V.classList.remove("is-dragging");
      V.releasePointerCapture(e.pointerId);
      momentumFrame = requestAnimationFrame(runMomentum);
      // Reset parallax gently after drag ends
      targetParallaxX = 0;
      targetParallaxY = 0;
      if (parallaxFrame === null) parallaxFrame = requestAnimationFrame(animateParallax);
    }

    function onWheel(e: WheelEvent) {
      e.preventDefault();
      dismissHint();
      stopMomentum();
      T.style.transition = "none";

      const { minX, maxX, minY, maxY } = getBounds();
      x = clamp(x - e.deltaX, minX - 60, maxX + 60);
      y = clamp(y - e.deltaY, minY - 60, maxY + 60);
      setTransform(x, y);

      velocityX = -e.deltaX * 0.5;
      velocityY = -e.deltaY * 0.5;
      stopMomentum();
      momentumFrame = requestAnimationFrame(runMomentum);
      // small parallax nudge on wheel
      targetParallaxX = clamp(-e.deltaX * 0.02, -PARALLAX_MAX, PARALLAX_MAX);
      targetParallaxY = clamp(-e.deltaY * 0.015, -PARALLAX_MAX, PARALLAX_MAX);
      if (parallaxFrame === null) parallaxFrame = requestAnimationFrame(animateParallax);
    }

    V.addEventListener("pointerdown", onPointerDown);
    V.addEventListener("pointermove", onPointerMove);
    V.addEventListener("pointerup", onPointerUp);
    V.addEventListener("pointercancel", onPointerUp);
    V.addEventListener("wheel", onWheel, { passive: false });
    V.addEventListener("pointerleave", () => {
      targetParallaxX = 0;
      targetParallaxY = 0;
      if (parallaxFrame === null) parallaxFrame = requestAnimationFrame(animateParallax);
    });

    // Prevent the browser's native drag-image ghost when dragging over <img>/<a>.
    V.addEventListener("dragstart", (e) => e.preventDefault());

    setTransform(x, y);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWorkCanvas);
  } else {
    initWorkCanvas();
  }
</script>