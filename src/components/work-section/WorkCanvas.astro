---
// src/components/WorkCanvas.astro
// Draggable "wall of cards" work section.
// Pan with mouse-drag, touch-drag, or scroll wheel. Inertia on release,
// soft bounce-back at edges. No external animation library.

export interface Project {
  title: string;
  category: string;
  tools: string;
  year: string;
  image: string;
  href: string;
  size?: "sm" | "md" | "lg"; // controls card footprint in the grid
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props as Props;
---

<section class="work" aria-label="Work">
  <div class="viewport" id="work-viewport">
    <div class="track" id="work-track">
      {
        projects.map((project, i) => (
          <a
            class={`card card--${project.size ?? "md"}`}
            href={project.href}
            style={`--jitter: ${((i % 5) - 2) * 0.6}deg`}
          >
            <div class="card__image-wrap">
              <img
                class="card__image"
                src={project.image}
                alt={project.title}
                loading="lazy"
                draggable="false"
              />
            </div>
            <div class="card__meta">
              <span class="card__title">{project.title} </span>
              <span class="card__sub">{project.category}<br></span>
              <span class="card__sub card__sub--faint">
                {project.tools} — {project.year}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <p class="hint" id="work-hint" aria-hidden="true">scroll / drag to move</p>
</section>

<style>


 .work {
  min-height: 100vh;
  overflow: visible;
}
  .card__image {
    width: 100%;
    height: auto;
    display: block;
}

  .viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    background-image: radial-gradient(
      circle  at 1px 1px,
      rgba(255, 255, 255, 0.212) 3px,
      transparent 0
    );
    background-size: 28px 28px;
  }

  .viewport.is-dragging {
    cursor: grabbing;
  }

 .track {
  position: relative;
  display: grid;

  width: 100%;
  max-width: 1400px;
  margin: 0 auto;

  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 40px;

  padding: 120px 40px;
}

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: #ede6d6;
    transform: rotate(var(--jitter));
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    user-select: none;
  }

  .card {
    /* let grid cell size determine footprint; keep block-level sizing */
    width: 100%;
  }

  .card--sm {
    aspect-ratio: 4 / 5;
  }

  .card--md {
    aspect-ratio: 3 / 2;
  }

  .card--lg {
    aspect-ratio: 5 / 3;
    grid-column: span 2;
    grid-row: span 2;
  }

  .card:hover {
    transform: rotate(0deg) scale(1.045) translateY(-4px);
    z-index: 2;
  }

  .card--sm {
    grid-column: span 1;
    grid-row: span 1;
  }
  .card--md {
    grid-column: span 1;
    grid-row: span 1;
  }
  .card--lg {
    grid-column: span 1;
    grid-row: span 2;
  }
  .card--lg .card__image-wrap {
    aspect-ratio: 3 / 4;
  }

  .card__image-wrap {
    position: relative;
    aspect-ratio: auto;
    overflow: hidden;
    background: #201e1a;
    box-shadow: 0 18px 30px -14px rgba(0, 0, 0, 0.7);
    transition: box-shadow 0.25s ease;
  }

  .card:hover .card__image-wrap {
    box-shadow: 0 28px 48px -16px rgba(0, 0, 0, 0.85);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

