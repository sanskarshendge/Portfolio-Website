---
// SkillsSection.astro
import skills from '../../data/skills.json';
---

<section class="skills" id="skills">
  <div class="skills-container">
    <h2 class="skills-title">Skills & Expertise</h2>

    <div class="skills-grid">
      {skills.map((skill) => (
        <a href={skill.link} class="flip-word">
          <span class="word">{skill.name}</span>
          <span class="word duplicate">{skill.name}</span>
        </a>
      ))}
    </div>

  </div>
</section>
<style>
  .skills {
    display: flex;
    
    width: 100%;
    align-items: center;
    background-color: var(--yellow-base);
    /* padding: var(--spacing-2xl) 0;*/
    perspective: 1000px;
  }

  .skills-container {
    display: flex;
    align-items: center;
    flex-direction: column;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .skills-title {
    font-family: var(--font-display);
    font-size: var(--text-7xl);
    font-weight: var(--weight-bold);
    color: var(--black);
    text-align: center;
    /*margin-bottom: var(--spacing-md);*/
  }
  .skills-grid {
    display:flex;
    flex-direction:column;
    text-align:center;
    justify-content:center; 
    flex-wrap:nowrap;
    gap:0rem;
  
  }
 
  .h3{
    margin-bottom: var(--spacing-xs);
  }
  .skill-name {
    align-items: center;
    display: flex;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    color: var(--black);
  }

  .skill-description {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--gray-dark);
    line-height: var(--leading-relaxed);
  }
 .flip-word{
  display:flex;
  justify-content:center;
  font-size:var(--text-5xl);
  align-items: center;
  position:relative;
  overflow:hidden;
  height:1.1em;
  cursor:pointer;
  line-height:1;
  background-color:var(--blue-primary);
  text-decoration: none;
}
.word{
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:var(--text-5xl);
  font-weight:700;
 /* transition:transform 0.25s cubic-bezier(.76,0,.24,1);*/
  
  transition:transform 0.25s cubic-bezier(.22,.61,.36,1);
  color:var(--black);
}
.duplicate{
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:var(--text-5xl);
  position:absolute;
  top:100%;
  color:var(--blue-primary)!important;
  
 
  
}
.flip-word:hover .word{
  display:flex;
  justify-content:center;
  align-items:center;
  transform:translateY(-100%);
  color:var(--blue-primary)!important;
}



  /* Mobile Responsive */
  @media (max-width: 768px) {
    .skills-title {
      font-size: var(--text-3xl);
    }

  
  }
</style>
