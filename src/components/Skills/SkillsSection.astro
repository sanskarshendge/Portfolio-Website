---
// SkillsSection.astro
import skills from '../../data/skills.json';
---

<section class="skills" id="skills">
  <div class="skills-container">
    <h2 class="skills-title">Skills & Expertise</h2>

    <div class="skills-grid">
      {skills.map((skill) => (
        <div class="flip-word">
          <span class="word">{skill.name}</span>
          <span class="word duplicate">{skill.name}</span>
        </div>
      ))}
    </div>

  </div>
</section>
<style>
  .skills {
    display: flex;
    
    width: 100%;
    align-items: center;
    background-color: var(--yellow-base);
    padding: var(--spacing-2xl) 0;
    perspective: 1000px;
  }

  .skills-container {
    display: flex;
    flex-direction: ;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .skills-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    color: var(--black);
    text-align: center;
    margin-bottom: var(--spacing-md);
  }
  .skills-grid {
    display:flex;
    flex-wrap:wrap;
    gap:2rem;
  
  }
 
  .h3{
    margin-bottom: var(--spacing-xs);
  }
  .skill-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--black);
  }

  .skill-description {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--gray-dark);
    line-height: var(--leading-relaxed);
  }
 .flip-word{
  position:relative;
  overflow:hidden;
  height:1.2em;
  cursor:pointer;
  line-height:1;
}
.word{
  display:block;
  font-size:2rem;
  font-weight:700;
  transition:transform 0.45s cubic-bezier(.76,0,.24,1);
  /*transition:transform 0.35s cubic-bezier(.22,.61,.36,1);*/
}
.duplicate{
  position:absolute;
  left:0;
  top:100%;
}
.flip-word:hover .word{
  transform:translateY(-100%);
}



  /* Mobile Responsive */
  @media (max-width: 768px) {
    .skills-title {
      font-size: var(--text-3xl);
    }

  
  }
</style>
